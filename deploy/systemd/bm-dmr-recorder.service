[Unit]
Description=BrandMeister DMR HBP recorder
Documentation=file:/opt/dmrlogger/docs/systemd.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bm-dmr
Group=bm-dmr
WorkingDirectory=/opt/dmrlogger
EnvironmentFile=/etc/dmrlogger.env
ExecStartPre=/usr/bin/python3 /opt/dmrlogger/healthcheck.py --component recorder --no-heartbeat
ExecStart=/opt/dmrlogger/run_direct_recorder.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
RestartForceExitStatus=124
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/dmrlogger

[Install]
WantedBy=multi-user.target
