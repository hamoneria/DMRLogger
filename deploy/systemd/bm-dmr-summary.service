[Unit]
Description=BrandMeister DMR daily summary loop
Documentation=file:/opt/dmrlogger/docs/systemd.md
After=network-online.target bm-dmr-poster.service
Wants=network-online.target bm-dmr-poster.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=bm-dmr
Group=bm-dmr
WorkingDirectory=/opt/dmrlogger
EnvironmentFile=/etc/dmrlogger.env
ExecStartPre=/usr/bin/python3 /opt/dmrlogger/healthcheck.py --component summary --no-heartbeat
ExecStart=/opt/dmrlogger/run_daily_summary.sh
Restart=always
RestartSec=30
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/dmrlogger

[Install]
WantedBy=multi-user.target
