# BrandMeister DMR recorder example environment.
# Copy to .env and replace placeholders. Do not commit .env.

# BrandMeister HBP master and hotspot credentials
BM_MASTER=2503.master.brandmeister.network
BM_PORT=62031
BM_RADIO_ID=123456789
BM_HOTSPOT_PASSWORD=change-me

# Main paths; defaults are relative to the project directory if omitted
# BM_APP_DIR=/opt/dmrlogger
# BM_RECORDINGS_DIR=/var/lib/dmrlogger/recordings
# BM_STATE_DIR=/var/lib/dmrlogger/state
# BM_ROUTES_CONFIG=/etc/dmrlogger/routes.json

# Speech recognition
# Default base is baked into the published image. Set small/medium/large-v3 for better quality on stronger servers.
WHISPER_MODEL=base

# Telegram Bot API
BM_DIRECT_TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=-1000000000000

# Optional: Pi-Star password helper. Not used by default in GitHub/deployment flow.
# Prefer BM_HOTSPOT_PASSWORD above for normal runs.
BM_FETCH_PISTAR_PASSWORD=0
PISTAR_HOST=192.0.2.10
PISTAR_USER=pi-star
PISTAR_LOGIN_PASSWORD=change-me

# Optional daily summary LLM integration
GEMINI_API_KEY=replace-me-if-used

# Optional summary runner (Docker profile: summary)
# Set BM_SUMMARY_POST=1 to send generated summaries to Telegram.
BM_SUMMARY_POST=0
BM_SUMMARY_INTERVAL_SECONDS=86400
BM_SUMMARY_HOURS=24
# Comma-separated route keys, e.g. 2501:1,250812:2. Empty = all configured routes.
BM_SUMMARY_ROUTE_KEYS=
BM_SUMMARY_USE_GEMINI=1
# Optional OpenRouter backend. If BM_SUMMARY_PROVIDER=openrouter and no model is set,
# DMRLogger uses OpenRouter's zero-cost free router by default.
# BM_SUMMARY_PROVIDER=openrouter
OPENROUTER_MODEL=openrouter/free

# Optional watchdog/healthcheck tuning
BM_RECORDER_MAX_STALE_SECONDS=180
BM_POSTER_MAX_STALE_SECONDS=900
# Heartbeat files normally default to $BM_STATE_DIR/{recorder,poster,summary}.heartbeat.json
# BM_RECORDER_HEARTBEAT_FILE=/var/lib/dmrlogger/state/recorder.heartbeat.json
# BM_POSTER_HEARTBEAT_FILE=/var/lib/dmrlogger/state/poster.heartbeat.json
# BM_SUMMARY_HEARTBEAT_FILE=/var/lib/dmrlogger/state/summary.heartbeat.json

# Optional retention/cleanup (Docker profile: cleanup)
# Deletes old recording artifacts and enforces disk caps. Dry-run first if unsure.
BM_RETENTION_DAYS=14
BM_RETENTION_MAX_BYTES=5G
BM_RETENTION_MIN_FREE_BYTES=1G
BM_RETENTION_DRY_RUN=0
BM_CLEANUP_INTERVAL_SECONDS=3600
